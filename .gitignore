# ========================================
# PluginCode 项目根目录 Git Ignore
# ========================================

# 环境变量（所有子项目 - 包含敏感密钥）
**/.env
**/.env.local
**/.env.*.local
**/.env.production
**/.env.development
# 注意：.env.example 可以提交（模板文件，不含敏感信息）

# 依赖目录
**/node_modules/
**/venv/
**/__pycache__/
**/.pnp
**/.pnp.js

# 构建产物
**/.output/
**/dist/
**/build/
**/*.zip
**/*.tar.gz
**/*.tgz

# WXT 生成文件
**/.wxt/
**/AITestCase@*

# IDE 和编辑器
.idea/
.vscode/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-project
*.sublime-workspace

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory
.Trash-*

# 日志文件
*.log
**/agent.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
pnpm-debug.log*

# 临时文件
*.tmp
*.temp
*.cache
.cache/

# 测试截图和文件
**/screenshots/
screenshot_*.png
**/screenshot_*.png
**/screenshot_*.jpg

# Python
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
*.egg
pip-log.txt
pip-delete-this-directory.txt

# TypeScript / JavaScript
*.tsbuildinfo
*.js.map
*.css.map
coverage/
.nyc_output/

# 临时 HTML
image_gallery.html

# 方案文档目录（不提交到代码库）
方案/

# 个人 Git 工作流文档（不提交到任何仓库）
GIT_WORKFLOW.md

# 子目录 .idea
**/.idea/

# 包管理器锁文件（可选，根据团队需求决定）
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

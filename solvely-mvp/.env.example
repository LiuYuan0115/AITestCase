# ===========================================
# AI Test Case Agent - 环境变量配置
# ===========================================
# 使用方法：复制此文件为 .env，然后修改对应的值

# ================= Agent 服务配置 =================
# 切换远程/本地模式（true = 远程，false = 本地）
VITE_USE_REMOTE=false

# 远程服务地址（当 VITE_USE_REMOTE=true 时生效）
VITE_REMOTE_AGENT_URL=https://ai-testcase-agent-server-490675215294.us-west1.run.app

# 远程服务 API Key（当 VITE_USE_REMOTE=true 时自动携带）
VITE_REMOTE_API_KEY=your_api_key_here

# 本地服务地址（当 VITE_USE_REMOTE=false 时生效，默认 http://localhost:8000）
VITE_LOCAL_AGENT_URL=http://localhost:8000

# ================= 上传服务配置（可选） =================
# 图片上传服务地址
# VITE_SOLVELY_UPLOAD_BASE=https://dev-webserver.solvely.ai

# 认证 Token
# VITE_SOLVELY_AUTH_TOKEN=your_auth_token_here

# 插件 UUID
# VITE_SOLVELY_PLUGIN_UUID=your_plugin_uuid_here

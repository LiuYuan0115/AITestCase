# ========================================
# Solvely MVP Chrome Extension - 环境变量配置示例
# 复制此文件为 .env 并填入实际值
# ========================================

# API 认证 Token (JWT)
VITE_AUTH_TOKEN=your_jwt_token_here

# API 基础 URL
VITE_API_BASE_URL=https://api-web.solvely.ai

# 设备 ID
VITE_DEVICE_ID=your_device_id_here

# 插件 UUID
VITE_PLUGIN_UUID=your_plugin_uuid_here

# 本地 Agent 服务器地址
VITE_LOCAL_AGENT_URL=http://localhost:8765

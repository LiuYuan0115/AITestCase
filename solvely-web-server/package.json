{
  "name": "solvely-web-server",
  "version": "2.1.0",
  "description": "",
  "private": true,
  "egg": {
    "declarations": true
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.549.0",
    "@aws-sdk/client-s3": "^3.476.0",
    "@aws-sdk/client-ses": "^3.890.0",
    "@aws-sdk/lib-dynamodb": "^3.549.0",
    "@aws-sdk/s3-request-presigner": "^3.876.0",
    "crypto": "^1.0.1",
    "decimal.js": "^10.4.3",
    "dotenv": "^16.4.5",
    "egg": "^3.17.5",
    "egg-cors": "^3.0.0",
    "egg-jwt": "^3.1.7",
    "egg-scripts": "2",
    "egg-sequelize": "^6.0.0",
    "egg-validate": "^2.0.2",
    "firebase-admin": "^12.0.0",
    "lodash": "^4.17.21",
    "moment": "^2.29.4",
    "mysql2": "^3.6.5",
    "node-rsa": "^1.1.1",
    "stripe": "^16.8.0",
    "uuid": "^9.0.1",
    "immer": "^10.1.1",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "egg-bin": "6",
    "egg-mock": "5",
    "eslint": "8",
    "eslint-config-egg": "13",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "prettier": "^3.2.5",
    "prettier-plugin-curly": "^0.2.1"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "start": "SOLVELY_WEB_SERVER_ENV=prod egg-scripts start --title=egg-server-solvely-web-server",
    "start:test": "SOLVELY_WEB_SERVER_ENV=test egg-scripts start --title=egg-server-solvely-web-server",
    "stop": "egg-scripts stop --title=egg-server-solvely-web-server",
    "restart": "npm run stop && npm run start",
    "dev": "SOLVELY_WEB_SERVER_ENV=local egg-bin dev",
    "test": "npm run lint -- --fix && npm run test:local",
    "test:local": "egg-bin test",
    "cov": "egg-bin cov",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "ci": "npm run lint && npm run cov",
    "debug": "SOLVELY_WEB_SERVER_ENV=local egg-bin debug",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "repository": {
    "type": "git",
    "url": ""
  },
  "author": "",
  "license": "MIT"
}

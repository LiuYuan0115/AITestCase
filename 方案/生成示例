### 4.2 Page Object模式
```javascript
// 登录页面对象
class LoginPage {
    // 页面元素定位
    get usernameInput() { return $('input[placeholder="账号"]'); }
    get passwordInput() { return $('input[placeholder="密码"]'); }
    get captchaInput() { return $('input[placeholder="验证码"]'); }
    get loginButton() { return $('.el-button--primary'); }
    get rememberCheckbox() { return $('.el-checkbox'); }
    
    // 页面操作方法
    async login(username, password, captcha) {
        await this.usernameInput.setValue(username);
        await this.passwordInput.setValue(password);
        await this.captchaInput.setValue(captcha);
        await this.loginButton.click();
    }
    
    async toggleRememberPassword() {
        await this.rememberCheckbox.click();
    }
}
```

### 4.3 Playwright MCP实现示例
```javascript
// 使用Playwright MCP的登录测试
async function testLogin() {
    // 导航到登录页面
    await mcp_playwright_playwright_navigate({
        url: 'https://vue.ruoyi.vip/login?redirect=%2Findex',
        browserType: 'chromium',
        headless: false
    });
    
    // 填写登录信息
    await mcp_playwright_playwright_fill({
        selector: 'input[placeholder="账号"]',
        value: 'testuser'
    });
    
    await mcp_playwright_playwright_fill({
        selector: 'input[placeholder="密码"]',
        value: 'testpassword'
    });
    
    // 处理验证码（需要OCR或其他识别方案）
    const captchaText = await getCaptchaText();
    await mcp_playwright_playwright_fill({
        selector: 'input[placeholder="验证码"]',
        value: captchaText
    });
    
    // 点击登录
    await mcp_playwright_playwright_click({
        selector: '.el-button--primary'
    });
    
    // 验证登录结果
    await mcp_playwright_playwright_screenshot({
        name: 'login_result',
        savePng: true
    });
}
```


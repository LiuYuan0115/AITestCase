{
  "name": "activity.solvely.ai",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "NUXT_ENV_MODE=dev nuxi dev",
    "generate": "nuxt generate && node scripts/postbuild.js",
    "generate:test": "NUXT_ENV_MODE=test nuxt generate && node scripts/postbuild.js",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint --ext .js,.ts,.vue .",
    "lint:fix": "eslint --ext .js,.ts,.vue . --fix",
    "format": "prettier --write . --log-level error",
    "prepare": "husky",
    "lint-staged": "lint-staged"
  },
  "dependencies": {
    "@adjustcom/adjust-web-sdk": "^5.7.2",
    "@nuxtjs/tailwindcss": "^6.12.2",
    "firebase": "^11.0.2",
    "nuxt": "^3.14.1592",
    "posthog-js": "^1.237.0",
    "vue": "latest",
    "vue-router": "latest",
    "vue3-lottie": "^3.3.1"
  },
  "devDependencies": {
    "@nuxtjs/eslint-config-typescript": "^12.1.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "prettier": "^3.4.1",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "terser": "^5.44.0"
  },
  "lint-staged": {
    "*.{js,ts,vue,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,scss,md}": [
      "prettier --write"
    ]
  }
}

# ========================================
# AI Test Case Agent Server - 环境变量配置示例
# 复制此文件为 .env 并填入实际值
# ========================================

# OpenAI/ZenMux API 配置
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://zenmux.ai/api/v1
ANTHROPIC_BASE_URL=https://zenmux.ai/api/anthropic

# 模型配置（全部使用 anthropic/claude-haiku-4.5）
DEFAULT_MODEL=anthropic/claude-haiku-4.5
MODEL_PRD=anthropic/claude-haiku-4.5
MODEL_TESTCASE=anthropic/claude-haiku-4.5
MODEL_UI=anthropic/claude-haiku-4.5
MODEL_CHAT=anthropic/claude-haiku-4.5
MODEL_ASK=anthropic/claude-haiku-4.5

# Ask 接口模型配置
ASK_TESTPRD_MODEL=anthropic/claude-haiku-4.5
ASK_TESTPOINT_MODEL=anthropic/claude-haiku-4.5
ASK_TESTCASE_MODEL=anthropic/claude-haiku-4.5
ASK_FIGMA_MODEL=anthropic/claude-haiku-4.5
ASK_DEFAULT_MODEL=anthropic/claude-haiku-4.5

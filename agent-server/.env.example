# ========================================
# AI Test Case Agent Server - 环境变量配置示例
# 复制此文件为 .env 并填入实际值
# ========================================

# ========================================
# 核心 API 配置
# ========================================
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://zenmux.ai/api/v1
ANTHROPIC_BASE_URL=https://zenmux.ai/api/anthropic

# ========================================
# 模型配置
# ========================================
DEFAULT_MODEL=anthropic/claude-haiku-4.5
MODEL_PRD=anthropic/claude-haiku-4.5
MODEL_TESTCASE=anthropic/claude-haiku-4.5
MODEL_UI=anthropic/claude-haiku-4.5
MODEL_CHAT=anthropic/claude-haiku-4.5
MODEL_ASK=anthropic/claude-haiku-4.5

# ========================================
# Ask 接口模型配置
# ========================================
ASK_TESTPRD_MODEL=anthropic/claude-haiku-4.5
ASK_TESTPOINT_MODEL=anthropic/claude-haiku-4.5
ASK_TESTCASE_MODEL=anthropic/claude-haiku-4.5
ASK_FIGMA_MODEL=anthropic/claude-haiku-4.5
ASK_DEFAULT_MODEL=anthropic/claude-haiku-4.5

# ========================================
# 功能开关
# ========================================
USE_CHROMADB=true
USE_QA_SKILL=true
USE_HISTORY_REFERENCE=true
USE_LLM_CACHE=true
USE_EMBEDDING_CACHE=true
USE_PDF_CACHE=true
USE_UI_SKILLS=true
USE_ASYNC_QUEUE=true

# ========================================
# ChromaDB 配置
# ========================================
CHROMA_DB_PATH=./data/chroma_db
CHROMA_COLLECTION_SESSION=session_docs
CHROMA_COLLECTION_HISTORY=history_cases
CHROMA_COLLECTION_KNOWLEDGE=company_knowledge
HF_ENDPOINT=https://hf-mirror.com

# ========================================
# 缓存配置
# ========================================
CACHE_DIR=./data/cache
LLM_CACHE_TTL=86400
EMBEDDING_CACHE_TTL=604800
PDF_CACHE_TTL=2592000
CACHE_MAX_SIZE_MB=500

# ========================================
# 批量处理配置
# ========================================
BATCH_UPLOAD_MAX_FILES=10
BATCH_UPLOAD_MAX_SIZE_MB=50
BATCH_UPLOAD_PARALLEL_WORKERS=4

# ========================================
# 异步任务队列配置
# ========================================
USE_ASYNC_QUEUE=true
QUEUE_BACKEND=memory
QUEUE_MAX_WORKERS=4
QUEUE_TIMEOUT=300

# ========================================
# 文件上传配置
# ========================================
UPLOAD_MAX_SIZE_MB=20
UPLOAD_ALLOWED_TYPES=pdf,png,jpg,jpeg,webp,txt,md
UPLOAD_SAVE_PATH=./data/uploads

# ========================================
# Tesseract OCR 配置
# ========================================
TESSERACT_LANG=chi_sim+eng

# ========================================
# Evaluator 评估器配置
# ========================================
EVALUATOR_MODEL=anthropic/claude-haiku-4.5
EVALUATOR_MIN_SCORE=70
EVALUATOR_TIMEOUT=60

# ========================================
# 服务配置
# ========================================
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO
CORS_ORIGINS=*

# ========================================
# 性能配置
# ========================================
MAX_CONCURRENT_REQUESTS=100
REQUEST_TIMEOUT=120
EMBEDDING_BATCH_SIZE=32

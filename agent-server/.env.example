# ========================================
# AI Test Case Agent Server - 环境变量配置示例
# 复制此文件为 .env 并填入实际值
# ========================================

# OpenAI/ZenMux API 配置
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://zenmux.ai/api/v1
OPENAI_BASE_URL=https://zenmux.ai/api/anthropic

# 模型配置
DEFAULT_MODEL=openai/gpt-4o

# 服务器配置
SERVER_HOST=0.0.0.0
SERVER_PORT=8765

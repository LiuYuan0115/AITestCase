{
  "name": "solvely.ai",
  "description": "AI Homework Helper",
  "private": true,
  "version": "0.5.5",
  "type": "module",
  "scripts": {
    "dev:open-server": "live-server --port=8080 --entry-file=./server/index.html --no-browser",
    "dev:server": "npm run dev:open-server & wxt",
    "dev:local": "wxt --mode development",
    "local": "wxt --mode development",
    "dev:prod": "wxt --mode production",
    "dev": "wxt --mode test",
    "dev:edge": "npm run dev:open-server & wxt -b edge",
    "dev:safari": "npm run dev:open-server & wxt -b safari --mv3",
    "dev:firefox": "npm run dev:open-server & wxt -b firefox",
    "build": "wxt build -b chrome && wxt build -b edge",
    "build:test": "wxt build -b chrome -m test && wxt build -b edge -m test",
    "build:chrome": "wxt build -b chrome",
    "build:edge": "wxt build -b edge",
    "build:safari": "wxt build -b safari --mv3",
    "build:firefox": "wxt build -b firefox",
    "zip": "npm run remove-hash && wxt zip -b chrome && wxt zip -b edge",
    "zip:test": "npm run remove-hash && wxt zip -b chrome -m test && wxt zip -b edge -m test",
    "zip:hjh": "npm run remove-hash && ZIP_PREFIX=hjh wxt zip -b chrome -m test",
    "zip:pc": "npm run remove-hash && ZIP_PREFIX=pc wxt zip -b chrome -m test",
    "zip:edge": "wxt zip -b edge",
    "zip:safari": "wxt zip -b safari",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "vue-tsc --noEmit",
    "postinstall": "wxt prepare",
    "remove-hash": "node scripts/remove-hash-from-wxt.cjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.5",
    "@heroicons/vue": "^2.1.5",
    "@mozilla/readability": "^0.6.0",
    "@panzoom/panzoom": "^4.6.0",
    "@primeuix/themes": "^1.1.1",
    "@sentool/fetch-event-source": "^0.6.0",
    "@trpc/client": "^10.45.2",
    "@trpc/server": "^10.45.2",
    "@types/uuid": "^10.0.0",
    "axios": "^1.8.2",
    "html2canvas": "^1.4.1",
    "lodash-es": "^4.17.21",
    "lottie-web": "^5.12.2",
    "marked": "^16.0.0",
    "mathpix-markdown-it": "^2.0.12",
    "mitt": "^3.0.1",
    "partial-json": "^0.1.7",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "5.4.54",
    "posthog-js-lite": "^3.5.1",
    "primevue": "^4.3.5",
    "spark-md5": "^3.0.2",
    "tailwindcss-rem2px-preset": "^1.0.3",
    "terser": "^5.39.0",
    "trpc-chrome": "^1.0.0",
    "uuid": "^11.1.0",
    "vue": "^3.5.11",
    "vue3-lottie": "^3.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@rollup/plugin-strip": "^3.0.4",
    "@types/chrome": "^0.0.269",
    "@types/html2canvas": "^0.5.35",
    "@types/lodash-es": "^4.17.12",
    "@types/spark-md5": "^3.0.5",
    "@wxt-dev/module-vue": "^1.0.1",
    "autoprefixer": "^10.4.20",
    "less": "^4.2.0",
    "live-server": "^1.2.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.2",
    "vite-svg-loader": "^5.1.0",
    "vue-tsc": "^2.1.6",
    "wxt": "^0.19.11"
  }
}
